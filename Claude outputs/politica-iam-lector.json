{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LeerDatosYModelos",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": [
        "arn:aws:s3:::f1-telemetry-datalake-gabriel/data/*",
        "arn:aws:s3:::f1-telemetry-datalake-gabriel/models/*"
      ]
    },
    {
      "Sid": "ListarParticiones",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::f1-telemetry-datalake-gabriel",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["data/*", "models/*"]
        }
      }
    }
  ]
}
